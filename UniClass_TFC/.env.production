# Configurações para Produção (Vercel)
# Cadastre estas variáveis em: Vercel → Project → Settings → Environment Variables
# (NÃO coloque valores reais neste arquivo — ele vai para o GitHub)

# Security
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
DEBUG=False
# Os domínios *.vercel.app já são aceitos automaticamente; inclua aqui só domínio próprio
ALLOWED_HOSTS=

# Database (MySQL online, ex.: Aiven)
DB_ENGINE=django.db.backends.mysql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=SENHA_SEGURA_AQUI
DB_HOST=endereco-do-servidor-mysql
DB_PORT=3306
DB_SSL=True
# Opcional: conteúdo do certificado CA do provedor (valida o certificado do banco)
DB_SSL_CA=

# E-mail (Gmail com Senha de App)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=UniClass <conta@gmail.com>

# Limite dos arquivos enviados (a Vercel aceita no máximo 4,5 MB por requisição)
ARQUIVO_TAMANHO_MAXIMO_MB=4